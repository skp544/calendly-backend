PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calendly?schema=public"

NODE_ENV="development"

SLOT_GENERATION_DAYS=30

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=calendly-tasks
TEMPORAL_ENABLED=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Calendly <noreply@example.com>"

# From Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

# Fallback email used only if the OAuth userinfo response has no email
GOOGLE_SENDER_EMAIL="info@example.com"

GOOGLE_CALENDER_ID=primary

REDIS_URL=redis://localhost:6379

# Origin allowed to call this API from a browser (the frontend's dev/prod URL)
CORS_ORIGIN=http://localhost:5173
