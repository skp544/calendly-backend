{
  "info": {
    "name": "Calendly Backend API",
    "description": "API collection for the calendly-backend project (users, event types, availability, bookings, public booking page, Google Calendar integration).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "hostId", "value": "1", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "eventTypeId", "value": "1", "type": "string" },
    { "key": "ruleId", "value": "1", "type": "string" },
    { "key": "exceptionId", "value": "1", "type": "string" },
    { "key": "slotId", "value": "", "type": "string" },
    { "key": "hostSlug", "value": "jane-doe", "type": "string" },
    { "key": "eventTypeSlug", "value": "30-min-call", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
          }
        },
        {
          "name": "Get User By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.doe@example.com\",\n  \"name\": \"Jane Doe\",\n  \"slug\": \"jane-doe\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Updated\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Event Types",
      "item": [
        {
          "name": "List Event Types",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-host-id", "value": "{{hostId}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/event-types", "host": ["{{baseUrl}}"], "path": ["api", "v1", "event-types"] }
          }
        },
        {
          "name": "Get Event Type By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-host-id", "value": "{{hostId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/event-types/{{eventTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "event-types", "{{eventTypeId}}"]
            }
          }
        },
        {
          "name": "Create Event Type",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-host-id", "value": "{{hostId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"30 Min Call\",\n  \"description\": \"A quick 30 minute sync\",\n  \"durationMinutes\": 30,\n  \"isActive\": true,\n  \"locationType\": \"online\",\n  \"locationValue\": \"https://meet.google.com/xyz\",\n  \"bufferBeforeMinutes\": 5,\n  \"bufferAfterMinutes\": 5,\n  \"slug\": \"30-min-call\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/event-types", "host": ["{{baseUrl}}"], "path": ["api", "v1", "event-types"] }
          }
        },
        {
          "name": "Update Event Type",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-host-id", "value": "{{hostId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"30 Min Call (Updated)\",\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/event-types/{{eventTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "event-types", "{{eventTypeId}}"]
            }
          }
        },
        {
          "name": "Delete Event Type",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "x-host-id", "value": "{{hostId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/event-types/{{eventTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "event-types", "{{eventTypeId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Public Event Type",
      "item": [
        {
          "name": "Get Event Type By Host + Slug (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/event-types/{{hostId}}/{{eventTypeSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "event-types", "{{hostId}}", "{{eventTypeSlug}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Availability",
      "item": [
        {
          "name": "List Rules",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-host-id", "value": "{{hostId}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/availability/rules", "host": ["{{baseUrl}}"], "path": ["api", "v1", "availability", "rules"] }
          }
        },
        {
          "name": "Create Rule",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-host-id", "value": "{{hostId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weekday\": 1,\n  \"startTime\": \"09:00\",\n  \"endTime\": \"17:00\",\n  \"timezone\": \"UTC\",\n  \"isActive\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/availability/rules", "host": ["{{baseUrl}}"], "path": ["api", "v1", "availability", "rules"] }
          }
        },
        {
          "name": "Update Rule",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-host-id", "value": "{{hostId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"10:00\",\n  \"endTime\": \"18:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/availability/rules/{{ruleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "availability", "rules", "{{ruleId}}"]
            }
          }
        },
        {
          "name": "Delete Rule",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "x-host-id", "value": "{{hostId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/availability/rules/{{ruleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "availability", "rules", "{{ruleId}}"]
            }
          }
        },
        {
          "name": "List Exceptions",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-host-id", "value": "{{hostId}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/availability/exceptions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "availability", "exceptions"] }
          }
        },
        {
          "name": "Create Exception",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-host-id", "value": "{{hostId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-08-15\",\n  \"type\": \"BLOCK_FULL_DAY\",\n  \"timezone\": \"UTC\",\n  \"reason\": \"Public holiday\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/availability/exceptions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "availability", "exceptions"] }
          }
        },
        {
          "name": "Update Exception",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-host-id", "value": "{{hostId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Updated reason\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/availability/exceptions/{{exceptionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "availability", "exceptions", "{{exceptionId}}"]
            }
          }
        },
        {
          "name": "Delete Exception",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "x-host-id", "value": "{{hostId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/availability/exceptions/{{exceptionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "availability", "exceptions", "{{exceptionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "List Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-host-id", "value": "{{hostId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings?status=CONFIRMED&from=2026-08-01&to=2026-08-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings"],
              "query": [
                { "key": "status", "value": "CONFIRMED", "disabled": true },
                { "key": "from", "value": "2026-08-01", "disabled": true },
                { "key": "to", "value": "2026-08-31", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-host-id", "value": "{{hostId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\",\n  \"inviteeEmail\": \"invitee@example.com\",\n  \"inviteeName\": \"John Invitee\",\n  \"inviteeNotes\": \"Looking forward to the call\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/bookings", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bookings"] }
          }
        }
      ]
    },
    {
      "name": "Google Integration",
      "item": [
        {
          "name": "Get Setup Auth URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/integrations/google/setup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "integrations", "google", "setup"]
            }
          }
        },
        {
          "name": "OAuth Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/integrations/google/callback?code=REPLACE_WITH_GOOGLE_AUTH_CODE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "integrations", "google", "callback"],
              "query": [{ "key": "code", "value": "REPLACE_WITH_GOOGLE_AUTH_CODE" }]
            }
          }
        }
      ]
    }
  ]
}
